				</SCType>
				<SCType ID="TailZPos" Caption="Tailstock Z" type="TMachineStateParameter">
					<Address DefaultValue="TZ"/>
					<Order DefaultValue="7"/>
					<Group DefaultValue="LinearAxis"/>
					<Priority DefaultValue="7"/>
					<AxisControl DefaultValue="Manual"/>
				</SCType>
					<SCType ID="TailX" Caption="Tail X" type="TToolAxisX">
					<ImageFile DefaultValue="XTailStock.osd"/>
					<ParameterName DefaultValue="TailXPos"/>
					<VisualProperties>
						<Visible DefaultValue="True"/>
						<IsTransparent DefaultValue="True"/>
						<Transparence DefaultValue="0.8"/>
					</VisualProperties>
					<SCType ID="TailZ" Caption="Tail Z" type="TToolAxisZ">
						<Direction>
							<X DefaultValue="-2.9238044001630872522327544133663"/>
							<Y DefaultValue="0"/>
							<Z DefaultValue="1"/>
						</Direction>
						<ImageFile DefaultValue="ZTailStock.osd"/>
