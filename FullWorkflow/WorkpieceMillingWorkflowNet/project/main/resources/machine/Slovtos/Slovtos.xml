<?xml version="1.0" encoding="UTF-8" ?>
<SCCollection>
	
    <SCType ID="TurnTable_Selector" Caption="Turn table Selector" Type="TCaseNode" IsStructural="True">
        <ActiveNode DefaultValue="Base1"/>
        <SCType ID="Base0" Caption="No Turn table" Type="TMachineNode"/>
        <SCType ID="Base1" Caption="Turn table" Type="TMachineNode">
			<SCType ID="AxisAPos" Caption="Axis A position" type="TMachineStateParameter">
				<Address DefaultValue="A"/>
				<Order DefaultValue="4"/>
				<Group DefaultValue="RotaryAxis"/>
				<Priority DefaultValue="4"/>
			</SCType>
			<SCType ID="TablePos" Caption="Rotary table position" type="TMachineStateParameter">
				<Address DefaultValue="XX"/>
				<Order DefaultValue="5"/>
				<Group DefaultValue="LinearAxis"/>
				<Priority DefaultValue="5"/>
				<AxisControl DefaultValue="Manual"/>
			</SCType>
			<SCType ID="Table" Caption="Table axis X" type="TToolAxisX">
				<ImageFile DefaultValue="AXAxis.osd"/>
				<ParameterName DefaultValue="TablePos"/>
				<SCType ID="AxisA" Caption="Axis A" type="TMachineAxis">
					<Matrix>
						<SCType ID="T1" type="TRotateY" DefaultValue="90"/>
						<!--SCType ID="T2" type="TTranslateZ" DefaultValue="254.6"/-->
					</Matrix>
					<ParameterName DefaultValue="AxisAPos"/>
					<AxisType DefaultValue="Rotary"/>
					<ImageFile DefaultValue="AAxis.osd"/>
					<VisualProperties>
						<Color>
							<R DefaultValue="244/256"/>
							<G DefaultValue="244/256"/>
							<B DefaultValue="244/256"/>
						</Color>
					</VisualProperties>
					<SCType ID="ChuckNode" Caption="Chuck" type="TMachineNode">
						<Matrix>
							<SCType ID="T1" type="TRotateY" DefaultValue="-90"/>
						</Matrix>
						<SCType ID="Table" Caption="Turn table" type="TWorkpieceHolderNode"/>
					</SCType>
				</SCType>
			</SCType>			
		</SCType>
	</SCType>

    <SCType ID="TailStock_Selector" Caption="TailStock Selector" Type="TCaseNode">
