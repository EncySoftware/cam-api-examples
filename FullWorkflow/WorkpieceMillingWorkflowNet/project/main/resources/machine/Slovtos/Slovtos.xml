						<VisualProperties>
							<Visible DefaultValue="True"/>
							<IsTransparent DefaultValue="True"/>
							<Transparence DefaultValue="0.8"/>
						</VisualProperties>
					</SCType>
				</SCType>
			</SCType>
	</SCType>	

