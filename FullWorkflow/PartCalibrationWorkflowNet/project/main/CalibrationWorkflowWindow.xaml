<Window x:Class="PartCalibrationWorkflowNet.CalibrationWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complex Part Calibration"
        Width="520" Height="680"
        MinWidth="420" MinHeight="540" ResizeMode="CanResize"
        Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PartCalibrationWorkflowNet;component/Themes/PluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="8,8,8,0">

            <!-- ── Tab 1: Create Points ─────────────────────────────────────── -->
            <TabItem Header="1. Create Points">
                <StackPanel Margin="12">
                    <TextBlock Text="Generates a point cloud over the surfaces currently selected on the model viewport. Points are placed under the chosen parent folder on the Model page."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Parent folder (Model tree path):" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbPointsParentFolder" Margin="0,0,0,8"/>

                    <TextBlock Text="Target folder name:" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtPointsFolderName" Margin="0,0,0,8"/>

                    <TextBlock Text="Number of points:" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtPointsCount" Width="80" HorizontalAlignment="Left"
                             Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtSelectedFacesCount" Text="Selected surfaces: —"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Button Content="Create point cloud" x:Name="BtnCreatePoints"
                            Click="BtnCreatePoints_Click" Padding="10,5" HorizontalAlignment="Left"/>
                    <TextBox x:Name="TxtPointsStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"/>
                </StackPanel>
            </TabItem>

            <!-- ── Tab 2: Create Probing Cycles ─────────────────────────────── -->
            <TabItem Header="2. Probing Cycles">
                <StackPanel Margin="12">
                    <TextBlock Text="Adds probing cycles to the chosen measurement operation, using points currently selected on the Model page. Surface normals come from the underlying geometry."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Project prep (use if the machine has no probing op / there are no setups):"
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnSetDefaultMachine" Content="Set default machine"
                                Click="BtnSetDefaultMachine_Click" Padding="8,4" Margin="0,0,6,0"/>
                        <Button x:Name="BtnCreateSetups" Content="Create setups"
                                Click="BtnCreateSetups_Click" Padding="8,4"/>
                    </StackPanel>

                    <TextBlock Text="Measurement operation:" Margin="0,0,0,2"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="BtnRefreshOperations" Content="↻" Width="28"
                                DockPanel.Dock="Right" Margin="4,0,0,0"
                                Click="BtnRefreshOperations_Click"
                                ToolTip="Reload operation list"/>
                        <ComboBox x:Name="CmbMeasurementOperation"/>
                    </DockPanel>

                    <TextBlock Text="Cycle type:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbCycleType" Margin="0,0,0,12">
                        <ComboBoxItem Content="SurfaceCycle"/>
                        <ComboBoxItem Content="BossCycle"/>
                        <ComboBoxItem Content="HoleCycle"/>
                        <ComboBoxItem Content="WebCycle"/>
                        <ComboBoxItem Content="GrooveCycle"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtSelectedPointsCount" Text="Selected points: —"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Button Content="Create probing cycles" x:Name="BtnCreateCycles"
                            Click="BtnCreateCycles_Click" Padding="10,5" HorizontalAlignment="Left"/>
                    <Button Content="Calculate + show NC" x:Name="BtnCalculateNc"
                            Click="BtnCalculateNc_Click" Padding="10,5" HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            ToolTip="Calculate the measurement toolpath and postprocess it to an NC program — the program you'd hand to the machine."/>
                    <TextBox x:Name="TxtCyclesStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"/>
                </StackPanel>
            </TabItem>

            <!-- ── Tab 3: Import Measured Points ────────────────────────────── -->
            <TabItem Header="3. Import Measured">
                <StackPanel Margin="12">
                    <TextBlock Text="Imports measured points from a probing-report file into a folder on the Model page. Parsers are pluggable — additional formats can be registered via the parser registry."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Parent folder (Model tree path):" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbMeasuredParentFolder" Margin="0,0,0,8"/>

                    <TextBlock Text="Target folder name:" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtMeasuredFolderName" Margin="0,0,0,8"/>

                    <TextBlock Text="File format:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbMeasuredParser" Margin="0,0,0,8"/>

                    <TextBlock Text="Emulate a machine measurement (no real machine): a 6-DOF rigid transform — rotation R = Rz·Ry·Rx (degrees) then translation (mm) — is applied to the points selected on the Model page, as if the workpiece sat off-nominal, and written to the file below."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Move (mm)  X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateTX" Text="2" Width="50" Margin="0,0,8,0"/>
                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateTY" Text="1" Width="50" Margin="0,0,8,0"/>
                        <TextBlock Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateTZ" Text="0.5" Width="50" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Rotate (°)  X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateRX" Text="0.3" Width="50" Margin="0,0,8,0"/>
                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateRY" Text="-0.2" Width="50" Margin="0,0,8,0"/>
                        <TextBlock Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtEmulateRZ" Text="1.0" Width="50" Margin="0,0,12,0"/>
                        <Button x:Name="BtnEmulateMeasured" Content="Emulate"
                                Click="BtnEmulateMeasured_Click" Padding="8,4"
                                ToolTip="Generate a measured-points file by applying the 6-DOF transform above to the selected points (for demo / no real machine)."/>
                    </StackPanel>

                    <TextBlock Text="Measured report file:" Margin="0,0,0,2"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="BtnImportMeasured" Content="Import points"
                                DockPanel.Dock="Right" Margin="4,0,0,0" Padding="10,5"
                                Click="BtnImportMeasured_Click"/>
                        <Button x:Name="BtnViewMeasuredFile" Content="🔍 View"
                                DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,5"
                                Click="BtnViewMeasuredFile_Click"
                                ToolTip="Open the selected measured file in the default viewer."/>
                        <Button x:Name="BtnBrowseMeasuredFile" Content="..." Width="28"
                                DockPanel.Dock="Right" Margin="4,0,0,0"
                                Click="BtnBrowseMeasuredFile_Click"/>
                        <TextBox x:Name="TxtMeasuredFilePath" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBox x:Name="TxtMeasuredStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"/>
                </StackPanel>
            </TabItem>

            <!-- ── Tab 4: Calculate Deviation ───────────────────────────────── -->
            <TabItem Header="4. Calculate">
                <StackPanel Margin="12">
                    <TextBlock Text="Computes a rigid-body transform (Kabsch SVD). Correspondence is matched by point name against the nominal folder; if that is empty or names don't line up, measured points are snapped to the nearest model surface. Default output format comes from the machine's ToolFrameOutput.Format."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Measured points folder:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbDeviationPointsFolder" Margin="0,0,0,8"/>

                    <TextBlock Text="Nominal points folder (match by name; empty → snap to surface):" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbDeviationNominalFolder" Margin="0,0,0,8"/>

                    <TextBlock Text="Output format:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbOutputFormat" Margin="0,0,0,8"/>

                    <TextBlock Text="Result:" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtDeviationResult"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="140" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True" Margin="0,0,0,8"/>

                    <TextBlock Text="Max residual deviation (mm):" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtDeviationMax" IsReadOnly="True"
                             Padding="4,3" Margin="0,0,0,12"/>

                    <Button Content="Calculate deviation" x:Name="BtnCalculateDeviation"
                            Click="BtnCalculateDeviation_Click" Padding="10,5" HorizontalAlignment="Left"/>
                    <TextBox x:Name="TxtDeviationStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"/>
                </StackPanel>
            </TabItem>

            <!-- ── Tab 5: Apply Result ──────────────────────────────────────── -->
            <TabItem Header="5. Apply">
                <StackPanel Margin="12">
                    <TextBlock Text="Applies the calibration transform computed on the previous tab. Three modes are available; non-applicable inputs are disabled."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Last calculation:" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtApplyPreview"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="100" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Apply mode:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbApplyMode" Margin="0,0,0,8"
                              SelectionChanged="CmbApplyMode_SelectionChanged">
                        <ComboBoxItem Content="Create LCS" Tag="CreateLCS"/>
                        <ComboBoxItem Content="Move PartStage" Tag="MovePart"/>
                        <ComboBoxItem Content="Transform 3D model" Tag="TransformModel"/>
                    </ComboBox>

                    <!-- mode-specific inputs -->
                    <StackPanel x:Name="PanelLcsName">
                        <TextBlock Text="New LCS name:" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtLcsName" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelPartStage" Visibility="Collapsed">
                        <TextBlock Text="Target PartStage:" Margin="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="BtnRefreshPartStages" Content="↻" Width="28"
                                    DockPanel.Dock="Right" Margin="4,0,0,0"
                                    Click="BtnRefreshPartStages_Click"
                                    ToolTip="Reload part-stage list"/>
                            <ComboBox x:Name="CmbPartStage"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="Panel3DModel" Visibility="Collapsed">
                        <TextBlock Text="Target 3D model folder:" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTarget3DModel" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Button Content="Apply" x:Name="BtnApply"
                            Click="BtnApply_Click" Padding="10,5" HorizontalAlignment="Left"/>
                    <Button Content="Copy result to clipboard" x:Name="BtnCopyResult"
                            Click="BtnCopyResult_Click" Padding="10,3"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <TextBox x:Name="TxtApplyStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" IsTabStop="False"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ── Progress bar at the bottom ─────────────────────────────── -->
        <ProgressBar x:Name="BusyIndicator" Grid.Row="1" Height="4" Margin="8,2,8,8"
                     IsIndeterminate="False" Visibility="Collapsed"/>
    </Grid>
</Window>
