<Window x:Class="PartCalibrationWorkflowNet.SimulatorParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulate Machine Setup (6-DOF)"
        Width="320" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Translation (mm):" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="TX:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="1" x:Name="TxBox"  Text="2" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="TY:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="1" Grid.Column="1" x:Name="TyBox"  Text="1" Margin="0,2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="TZ:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="2" Grid.Column="1" x:Name="TzBox"  Text="0.5" Margin="0,2"/>
        </Grid>

        <TextBlock Text="Rotation (degrees, Euler XYZ):" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="RX:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="0" Grid.Column="1" x:Name="RxBox"  Text="0.3"  Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="RY:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="1" Grid.Column="1" x:Name="RyBox"  Text="-0.2" Margin="0,2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="RZ:" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="2" Grid.Column="1" x:Name="RzBox"  Text="1.0"  Margin="0,2"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"     Width="72" Margin="0,0,8,0" IsDefault="True"  Click="OkClicked"/>
            <Button Content="Cancel" Width="72"                   IsCancel="True"   Click="CancelClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
