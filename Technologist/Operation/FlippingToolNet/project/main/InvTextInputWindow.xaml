<Window x:Class="ExtensionOperationFlipToolNet.InvTextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Normal Vector Settings" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Flips Section - Left Side -->
        <TextBlock x:Name="FlipsHeader" Text="Flip Options:" 
                   Grid.Row="0" Grid.Column="0" 
                   Margin="0,0,0,10" FontWeight="Bold"/>
        
        <ScrollViewer Grid.Row="1" Grid.Column="0" 
                      VerticalScrollBarVisibility="Auto" 
                      VerticalAlignment="Top"
                      Margin="0,0,0,15">
            <StackPanel x:Name="FlipsPanel" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- Normal Selection Section - Right Side -->
        <StackPanel Grid.Row="1" Grid.Column="2" 
                    Orientation="Vertical" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,15">
            <TextBlock Text="Select Normal Direction:" 
                       Margin="0,0,0,10" FontWeight="Bold"/>
            
            <ComboBox x:Name="NormalComboBox" 
                      MinWidth="180"
                      MaxWidth="220"
                      Height="25"
                      HorizontalAlignment="Left" 
                      Margin="0,0,0,15" 
                      SelectionChanged="NormalComboBox_SelectionChanged">
                <ComboBoxItem Content="Up"/>
                <ComboBoxItem Content="Down"/>
                <ComboBoxItem Content="Forward"/>
                <ComboBoxItem Content="Backward"/>
                <ComboBoxItem Content="Left"/>
                <ComboBoxItem Content="Right"/>
            </ComboBox>

            <!-- XYZ Coordinates Section -->
            <TextBlock Text="XYZ Coordinates:" 
                       Margin="0,0,0,10" FontWeight="Bold"/>
            
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0,0,0,20">
                <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="XTextBox" Width="60" Margin="0,0,15,0" Text="0"/>
                
                <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="YTextBox" Width="60" Margin="0,0,15,0" Text="0"/>
                
                <TextBlock Text="Z:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="ZTextBox" Width="60" Text="0"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons - Span all columns -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Click="Ok_ClickInv"/>
        </StackPanel>
    </Grid>
</Window>