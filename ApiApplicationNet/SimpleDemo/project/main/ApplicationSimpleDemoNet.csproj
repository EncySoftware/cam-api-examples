<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <CetCompat>false</CetCompat>
        <!-- Run on the DLLs of the installation in OutDir; copying package DLLs would overwrite them with other versions -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <OutDir>C:\Program Files\ENCY Software\ENCY 3\Bin64</OutDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EncySoftware.CAMIPC.Sdk.Net" Version="3.0.19" />
        <PackageReference Include="EncySoftware.PathAliasesResolver" Version="3.0.0" />
        <PackageReference Include="EncySoftware.AssemblyLoaderTypes.Net" Version="3.0.1" />
        <PackageReference Include="EncySoftware.AppStarterInterface.Net" Version="3.0.1" />
        <PackageReference Include="EncySoftware.STAssemblyWrapper" Version="3.0.1" />
        <PackageReference Include="EncySoftware.STLoggingInterface.Net" Version="3.0.1" />
    </ItemGroup>
</Project>
