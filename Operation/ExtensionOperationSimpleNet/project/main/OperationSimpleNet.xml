        <Image DefaultValue="$(SUPPLEMENT_FOLDER)\operations\MillOperations\Images\Knife5D.bmp"/>
        <Icon DefaultValue="$(SUPPLEMENT_FOLDER)\operations\MillOperations\Images\Knife5DIcon.bmp"/>
