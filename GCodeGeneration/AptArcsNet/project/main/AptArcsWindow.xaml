<Window x:Class="AptArcsNet.AptArcsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APT Arcs Example"
        Width="820" Height="560"
        MinWidth="520" MinHeight="320"
        Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AptArcsNet;component/Themes/PluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnRun" Content="Load APT and calculate"
                    Click="BtnRun_Click" HorizontalAlignment="Left"/>
            <CheckBox x:Name="ChkArcsOnly" Content="arcs only" Margin="12,0,0,0"
                      VerticalAlignment="Center" Checked="ArcsOnly_Changed" Unchecked="ArcsOnly_Changed"/>
            <ProgressBar x:Name="BusyIndicator" Width="120" Height="14" Margin="12,0,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="The sample program writes its 8 arcs as CIRCLE records."/>

        <ListView Grid.Row="2" x:Name="NodesList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding Index}"/>
                    <GridViewColumn Header="Kind" Width="66" DisplayMemberBinding="{Binding KindText}"/>
                    <GridViewColumn Header="R" Width="56" DisplayMemberBinding="{Binding RadiusText}"/>
                    <GridViewColumn Header="Toolpath node" Width="600" DisplayMemberBinding="{Binding Caption}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Open a project with a milling machine, then click the button."/>
    </Grid>
</Window>
