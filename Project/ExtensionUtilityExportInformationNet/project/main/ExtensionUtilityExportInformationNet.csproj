<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutDir>bin\$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EncySoftware.CAMAPI.Sdk.Net" Version="3.0.7-dev.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\FilesInStreamApi\*.cs" LinkBase="FilesInStreamApi" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ExtensionUtilityExportInformationNet.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SDK build fingerprints are internal build metadata, not extension content. -->
  <Target Name="RemoveSdkBuildMetadata" AfterTargets="Build" BeforeTargets="PublishViewer">
    <ItemGroup>
      <SdkBuildMetadata Include="$(TargetDir)*.stbuildresult.json" />
    </ItemGroup>
    <Delete Files="@(SdkBuildMetadata)" />
  </Target>
  <Target Name="PublishViewer" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\..\viewer\main\ProjectInfoViewer.csproj&quot; -c Release -o &quot;$(TargetDir)Viewer&quot; --nologo -v q" />
  </Target>
</Project>
