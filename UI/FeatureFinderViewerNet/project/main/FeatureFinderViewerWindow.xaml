<Window x:Class="FeatureFinderViewerNet.FeatureFinderViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feature Finder Viewer"
        Width="900" Height="600"
        MinWidth="500" MinHeight="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150" MinHeight="60"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
            <Button x:Name="BtnRefresh" Content="Refresh" Width="80" Click="BtnRefresh_Click"/>
            <ProgressBar x:Name="BusyIndicator" Width="150" Height="16" Margin="8,0,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="100"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LeftList" Grid.Column="0"
                     SelectionChanged="LeftList_SelectionChanged"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>
            <ListBox x:Name="RightList" Grid.Column="2"
                     SelectionChanged="RightList_SelectionChanged"/>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="LightGray"/>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" x:Name="BtnSelectAll" Content="Select All"
                        HorizontalAlignment="Left" Margin="2,2,2,2"
                        Click="BtnSelectAll_Click"/>
                <ListBox Grid.Row="1" x:Name="EntityList"
                         SelectionMode="Extended"
                         SelectionChanged="EntityList_SelectionChanged"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="LightGray"/>

        <ListView Grid.Row="3" x:Name="InfoList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Property" Width="130" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Value" Width="400" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
