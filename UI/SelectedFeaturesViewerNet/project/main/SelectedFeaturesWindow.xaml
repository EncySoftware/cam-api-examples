<Window x:Class="SelectedFeaturesViewerNet.SelectedFeaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selected Features Viewer"
        Width="560" Height="460"
        MinWidth="380" MinHeight="260"
        Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SelectedFeaturesViewerNet;component/Themes/PluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnGetFeatures" Content="Get features for selected"
                    Click="BtnGetFeatures_Click" HorizontalAlignment="Left"/>
            <ProgressBar x:Name="BusyIndicator" Width="120" Height="14" Margin="8,0,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Select geometry nodes in the viewport, then click the button."/>

        <ListView Grid.Row="2" x:Name="FeaturesList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Caption" Width="240" DisplayMemberBinding="{Binding Caption}"/>
                    <GridViewColumn Header="Feature type" Width="170" DisplayMemberBinding="{Binding FeatureType}"/>
                    <GridViewColumn Header="Id" Width="120" DisplayMemberBinding="{Binding Id}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
