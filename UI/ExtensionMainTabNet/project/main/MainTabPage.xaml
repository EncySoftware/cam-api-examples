<UserControl x:Class="ExtensionMainTabNet.MainTabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFDDDDDD" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#FF32343C" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF42444C" />
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="16,14">
        <TextBlock Text="Main tab example" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Margin="0,14,0,2" Text="Active project" Opacity="0.7" />
        <TextBlock x:Name="ProjectText" TextWrapping="Wrap" />
        <Button Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Content="Go to the Model tab"
                ToolTip="Make the Model tab active"
                Style="{StaticResource GhostButton}"
                Click="OnModelClick" />
        <TextBlock x:Name="ErrorText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#FFE06C6C"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
