<Window x:Class="ExtensionEmbeddedInspectorNet.StockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock"
        Width="380" Height="460" MinWidth="300" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFDDDDDD" />
    </Window.Resources>
    <DockPanel>
        <TextBlock x:Name="SummaryText"
                   DockPanel.Dock="Top"
                   Margin="12,10,12,8"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}" />
        <Border x:Name="InspectorPlace" />
    </DockPanel>
</Window>
