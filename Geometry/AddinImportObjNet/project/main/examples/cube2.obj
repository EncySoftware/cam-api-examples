g obj_parallelepiped

#
# object obj_parallelepiped (with texture coordinates)
#

# Vertex positions
v 0.0 0.0 0.0    # v1 left-bottom-front
v 2.0 0.0 0.0    # v2 right-bottom-front
v 2.0 3.0 0.0    # v3 right-top-front
v 0.0 3.0 0.0    # v4 left-top-front
v 0.0 0.0 4.0    # v5 left-bottom-back
v 2.0 0.0 4.0    # v6 right-bottom-back
v 2.0 3.0 4.0    # v7 right-top-back
v 0.0 3.0 4.0    # v8 left-top-back

# Texture coordinates (vt)
vt 0.0 0.0       # vt1
vt 1.0 0.0       # vt2
vt 1.0 1.0       # vt3
vt 0.0 1.0       # vt4
vt 0.0 0.0       # vt5 (repeated for back face)
vt 1.0 0.0       # vt6
vt 1.0 1.0       # vt7
vt 0.0 1.0       # vt8

# Vertex normals
vn 0 0 -1        # front normal
vn 0 0 1         # back normal
vn -1 0 0        # left normal
vn 1 0 0         # right normal
vn 0 1 0         # top normal
vn 0 -1 0        # bottom normal

s off

# Front face (Z=0)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Back face (Z=4)
f 6/6/2 5/5/2 8/8/2
f 6/6/2 8/8/2 7/7/2

# Left face (X=0)
f 5/1/3 1/2/3 4/3/3
f 5/1/3 4/3/3 8/4/3

# Right face (X=2)
f 2/2/4 6/1/4 7/4/4
f 2/2/4 7/4/4 3/3/4

# Top face (Y=3)
f 4/4/5 3/3/5 7/7/5
f 4/4/5 7/7/5 8/8/5

# Bottom face (Y=0)
f 5/5/6 6/6/6 2/2/6
f 5/5/6 2/2/6 1/1/6