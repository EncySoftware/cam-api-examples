g obj_hexagonal_prism

#
# object obj_hexagonal_prism (regular)
#

# Vertices (bottom hexagon - Z = 0)
v 1.000 0.000 0.000    # v1
v 0.500 0.866 0.000    # v2
v -0.500 0.866 0.000   # v3
v -1.000 0.000 0.000   # v4
v -0.500 -0.866 0.000  # v5
v 0.500 -0.866 0.000   # v6

# Vertices (top hexagon - Z = 2)
v 1.000 0.000 2.000    # v7
v 0.500 0.866 2.000    # v8
v -0.500 0.866 2.000   # v9
v -1.000 0.000 2.000   # v10
v -0.500 -0.866 2.000  # v11
v 0.500 -0.866 2.000   # v12
# 12 vertices

# Normals
vn 0.000 0.000 -1.000  # bottom face
vn 0.000 0.000 1.000   # top face

# Side normals (perpendicular to each face)
vn 0.866 0.500 0.000   # front-right
vn 0.000 1.000 0.000    # front
vn -0.866 0.500 0.000   # front-left
vn -0.866 -0.500 0.000  # back-left
vn 0.000 -1.000 0.000   # back
vn 0.866 -0.500 0.000   # back-right
# 8 normals

s off

# Bottom face (Z = 0)
f 6//1 5//1 4//1
f 6//1 4//1 3//1
f 6//1 3//1 2//1
f 6//1 2//1 1//1

# Top face (Z = 2)
f 7//2 8//2 9//2
f 7//2 9//2 10//2
f 7//2 10//2 11//2
f 7//2 11//2 12//2

# Side faces (quads converted to triangles)
# Front-right face
f 1//3 2//3 8//3
f 1//3 8//3 7//3

# Front face
f 2//4 3//4 9//4
f 2//4 9//4 8//4

# Front-left face
f 3//5 4//5 10//5
f 3//5 10//5 9//5

# Back-left face
f 4//6 5//6 11//6
f 4//6 11//6 10//6

# Back face
f 5//7 6//7 12//7
f 5//7 12//7 11//7

# Back-right face
f 6//8 1//8 7//8
f 6//8 7//8 12//8

# 20 faces total (8 for top/bottom, 12 for sides)